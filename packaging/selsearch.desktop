[Desktop Entry]
Type=Application
Name=Selsearch
GenericName=Screen Search
Comment=Select anything on screen to copy, translate, search or ask about it
Exec=selsearch launcher
Icon=system-search
Categories=Utility;
Keywords=search;ocr;lens;translate;launcher;
